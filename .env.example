# Copy to .env. Never commit real credentials.
HOST=127.0.0.1
PORT=8090
# Use this same browser origin for both providers' registered callback URIs.
APP_URL=http://localhost:8090
COOKIE_SECURE=0
# ---------------------------------------------------------
# PostgreSQL - local Docker
# ---------------------------------------------------------
POSTGRES_DB=kdh_report
POSTGRES_USER=kdh
POSTGRES_PORT=5433

# Generate a strong local password. Never commit the real value.
POSTGRES_PASSWORD=

# Fixed Fernet key used to encrypt provider credentials when using PostgreSQL.
ENCRYPTION_KEY=

# Optional for non-Docker / hosted deployment such as Neon.
# Docker Compose builds its own DATABASE_URL from POSTGRES_* above.
DATABASE_URL=
JOB_MODE=worker
# Backend-only Bearer token for KDH-Report-New. Empty disables the internal API.
REPORT_SERVICE_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8090/api/google/callback
# Meta OAuth only. Keep the App Secret on the backend.
META_APP_ID=
META_APP_SECRET=
# Facebook Login for Business configuration ID (user access token).
META_CONFIG_ID=
META_GRAPH_VERSION=v26.0
META_REDIRECT_URI=http://localhost:8090/api/meta/callback
GA4_PROPERTY_ID=484358741
GSC_PROPERTY=https://kinderhealth.vn/
KEYWORD_SPREADSHEET_ID=1oVC_gc-_878btw6GJ9gQSDHJ7sqiGu2QB-lqMArqbSo
KEYWORD_SHEET=Ranking
# For wide Ranking sheets with headers like Jul/16, set the actual tracking year.
# Leave empty to reject ambiguous dates instead of inventing a year.
KEYWORD_TRACKING_YEAR=
LEGACY_REPORT_DIR=D:/KDH-Report/KDH-Report
DASHBOARD_URL=http://127.0.0.1:8088
